{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albumzh.example/schema/layout-templates-v1.schema.json",
  "title": "Album Photo layout template manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "modelGeneration", "canonicalPage", "templates"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "modelGeneration": { "const": "album-photo-canvas-v1" },
    "canonicalPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 2400 },
        "height": { "const": 3000 }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 32,
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["centerX", "centerY", "width", "height", "rotationRadians"],
      "properties": {
        "centerX": { "type": "number", "minimum": 0, "maximum": 1 },
        "centerY": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "height": { "type": "number", "minimum": 0.05, "maximum": 1 },
        "rotationRadians": { "type": "number" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "geometry", "readingOrder"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["photo", "text"] },
        "geometry": { "$ref": "#/$defs/geometry" },
        "readingOrder": { "type": "integer", "minimum": 0 },
        "defaultPhotoStyle": { "type": ["object", "null"] },
        "defaultTextStyle": { "type": ["object", "null"] }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "isActive", "localizedNameKey", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "integer", "minimum": 1 },
        "isActive": { "type": "boolean" },
        "localizedNameKey": { "type": "string", "minLength": 1 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    }
  }
}
